>@ "sys/arg",
>@ "str/str"

nativePackage: "libssl"
nativePackage: "libcrypto"

JADA_VERSION:: "0.1.1"
DEFAULT_CONFIG:: "config.json"
DEFAULT_CLI_TARGET:: "127.0.0.1:8080"
DEFAULT_API_PORT:: 8080
EOF_MARKER:: "__JADA_INPUT_CLOSED__"

# Native core inclusion
outerCPP: "
#include \"native/jada_native.cpp\"
"

# Native bridge
nativeRunNode::{String}->{Int}: (
    configPath: Ri
    status: 1
    innerCPP: "
        std::string pathText(reinterpret_cast<char const*>(configPath._data), configPath._size);
        status = jada_native::run_node(pathText);
    "
    status
)

nativeStartLocalNode::{String}->{String}: (
    configPath: Ri
    out: ""
    innerCPP: "
        std::string pathText(reinterpret_cast<char const*>(configPath._data), configPath._size);
        std::string result = jada_native::start_local_node(pathText);
        unsigned char* data = (unsigned char*)malloc(result.size());
        if (!result.empty()) memcpy(data, result.data(), result.size());
        out = String((int)result.size(), data);
    "
    out
)

nativeStopLocalNode::{}->{String}: (
    out: ""
    innerCPP: "
        std::string result = jada_native::stop_local_node();
        unsigned char* data = (unsigned char*)malloc(result.size());
        if (!result.empty()) memcpy(data, result.data(), result.size());
        out = String((int)result.size(), data);
    "
    out
)

nativeLocalNodeStatus::{}->{String}: (
    out: ""
    innerCPP: "
        std::string result = jada_native::local_node_status();
        unsigned char* data = (unsigned char*)malloc(result.size());
        if (!result.empty()) memcpy(data, result.data(), result.size());
        out = String((int)result.size(), data);
    "
    out
)

nativeLocalNodeTarget::{}->{String}: (
    out: ""
    innerCPP: "
        std::string result = jada_native::local_node_target();
        unsigned char* data = (unsigned char*)malloc(result.size());
        if (!result.empty()) memcpy(data, result.data(), result.size());
        out = String((int)result.size(), data);
    "
    out
)

nativeExchange::{target:String, port:Int, payload:String}->{String}: (
    targetText: Ri.target
    defaultPort: Ri.port
    payloadText: Ri.payload
    out: ""
    innerCPP: "
        std::string targetValue(reinterpret_cast<char const*>(targetText._data), targetText._size);
        std::string payloadValue(reinterpret_cast<char const*>(payloadText._data), payloadText._size);
        std::string response = jada_native::exchange(
            targetValue,
            static_cast<uint16_t>(defaultPort),
            payloadValue
        );
        unsigned char* data = (unsigned char*)malloc(response.size());
        if (!response.empty()) memcpy(data, response.data(), response.size());
        out = String((int)response.size(), data);
    "
    out
)

readLine::{String}->{String}: (
    prompt: Ri
    out: ""
    innerCPP: "
        std::string promptText(reinterpret_cast<char const*>(prompt._data), prompt._size);
        std::cout << promptText << std::flush;
        std::string inputText;
        if (!std::getline(std::cin, inputText)) inputText = \"__JADA_INPUT_CLOSED__\";
        unsigned char* data = (unsigned char*)malloc(inputText.size());
        if (!inputText.empty()) memcpy(data, inputText.data(), inputText.size());
        out = String((int)inputText.size(), data);
    "
    out
)

tokenize::{String}->{StringArray}: (
    line: Ri
    out: StringArray: 0
    innerCPP: "
        std::string inputText(reinterpret_cast<char const*>(line._data), line._size);
        std::vector<std::string> words;
        std::string current;
        bool quoted = false;
        bool escaped = false;
        char quote = 0;

        for (char c : inputText) {
            if (escaped) {
                current.push_back(c);
                escaped = false;
                continue;
            }
            if (c == '\\\\') {
                escaped = true;
                continue;
            }
            if (quoted) {
                if (c == quote) {
                    quoted = false;
                    quote = 0;
                } else {
                    current.push_back(c);
                }
                continue;
            }
            if (c == '\"' || c == 39) {
                quoted = true;
                quote = c;
                continue;
            }
            if (std::isspace(static_cast<unsigned char>(c))) {
                if (!current.empty()) {
                    words.push_back(current);
                    current.clear();
                }
                continue;
            }
            current.push_back(c);
        }

        if (escaped) current.push_back('\\\\');
        if (!current.empty()) words.push_back(current);

        StringArray wordsOut = makeStringArray((int)words.size());
        for (int i = 0; i < (int)words.size(); ++i) {
            wordsOut._data[i]._size = (int)words[i].size();
            wordsOut._data[i]._data = (unsigned char*)malloc(words[i].size());
            if (!words[i].empty()) memcpy(wordsOut._data[i]._data, words[i].data(), words[i].size());
        }
        return wordsOut;
    "
    out
)

exitWith::{Int}: (
    code: Ri
    innerCPP: "::exit(code);"
)


# Hachi string and JSON helpers
isTrueText::{String}->{Bool}: (
    text: Ri
    out: fls
    text = "true" ? (
        out: tru
    )|(
        text = "1" ? (
            out: tru
        )|(
            pass
        )
    )
    out
)

isExitCommand::{String}->{Bool}: (
    text: Ri
    out: fls
    text = "exit" ? (
        out: tru
    )|(
        text = "quit" ? (
            out: tru
        )|(
            pass
        )
    )
    out
)

isHelpOption::{String}->{Bool}: (
    text: Ri
    out: fls
    text = "-h" ? (
        out: tru
    )|(
        text = "--help" ? (
            out: tru
        )|(
            pass
        )
    )
    out
)

jsonEscape::{String}->{String}: (
    text: Ri
    out: ""
    bs: 92.toascii
    dq: 34.toascii
    i: 0 | i < text.len | i: i + 1 @ (
        ch: text.at: i
        ch = 34 ? (
            out: out + bs + dq
        )|(
        ch = 92 ? (
            out: out + bs + bs
        )|(
        ch = 10 ? (
            out: out + bs + "n"
        )|(
        ch = 13 ? (
            out: out + bs + "r"
        )|(
        ch = 9 ? (
            out: out + bs + "t"
        )|(
            out: out + ch.toascii
        )))))
    )
    out
)

jsonQuote::{String}->{String}: (
    dq: 34.toascii
    escaped: jsonEscape: Ri
    dq + escaped + dq
)

beforeFirstEquals::{String}->{String}: (
    text: Ri
    out: ""
    found: fls
    i: 0 | i < text.len | i: i + 1 @ (
        ch: text.at: i
        found ? (
            pass
        )|(
            ch = 61 ? (
                found: tru
            )|(
                out: out + ch.toascii
            )
        )
    )
    out
)

afterFirstEquals::{String}->{String}: (
    text: Ri
    out: ""
    found: fls
    i: 0 | i < text.len | i: i + 1 @ (
        ch: text.at: i
        found ? (
            out: out + ch.toascii
        )|(
            ch = 61 ? (
                found: tru
            )|(
                pass
            )
        )
    )
    out
)

containsEquals::{String}->{Bool}: (
    text: Ri
    found: fls
    i: 0 | i < text.len | i: i + 1 @ (
        (text.at: i) = 61 ? (
            found: tru
        )|(
            pass
        )
    )
    found
)

# JSON request builders
putPayload::{StringArray}->{String}: (
    args: Ri
    key: args.get: 1
    value: args.get: 2
    ttl: ""
    infinite: "false"

    i: 3 | i < args.len | i: i + 1 @ (
        option: args.get: i
        startsWith: option, "ttl=" ? (
            ttl: afterFirstEquals: option
        )|(
        startsWith: option, "infinite=" ? (
            raw: afterFirstEquals: option
            isTrueText: raw ? (
                infinite: "true"
            )|(
                infinite: "false"
            )
        )|(
            pass
        ))
    )

    out: "{\"op\":\"put\",\"key\":" + (jsonQuote: key)
    out: out + ",\"value\":" + (jsonQuote: value)
    ttl.len > 0 ? (
        out: out + ",\"ttl\":" + ttl
    )|(
        pass
    )
    out: out + ",\"infinite\":" + infinite + "}"
    innerCPP: "args._data = nullptr; args._size = 0;"
    out
)

getPayload::{String}->{String}: (
    "{\"op\":\"get\",\"key\":" + (jsonQuote: Ri) + "}"
)

groupGetPayload::{String}->{String}: (
    "{\"op\":\"group.get\",\"group\":" + (jsonQuote: Ri) + "}"
)

nearestPayload::{String}->{String}: (
    "{\"op\":\"nearest\",\"target\":" + (jsonQuote: Ri) + "}"
)

groupPutPayload::{StringArray}->{String}: (
    args: Ri
    groupName: args.get: 1
    items: "["
    firstItem: tru
    ttl: ""
    infinite: "false"

    i: 2 | i < args.len | i: i + 1 @ (
        token: args.get: i
        startsWith: token, "ttl=" ? (
            ttl: afterFirstEquals: token
        )|(
        startsWith: token, "infinite=" ? (
            raw: afterFirstEquals: token
            isTrueText: raw ? (
                infinite: "true"
            )|(
                infinite: "false"
            )
        )|(
        containsEquals: token ? (
            key: beforeFirstEquals: token
            value: afterFirstEquals: token
            firstItem ? (
                firstItem: fls
            )|(
                items: items + ","
            )
            item: "{\"key\":" + (jsonQuote: key) + ",\"value\":" + (jsonQuote: value) + "}"
            items: items + item
        )|(
            pass
        )))
    )

    items: items + "]"
    out: "{\"op\":\"group.put\",\"group\":" + (jsonQuote: groupName)
    out: out + ",\"items\":" + items
    ttl.len > 0 ? (
        out: out + ",\"ttl\":" + ttl
    )|(
        pass
    )
    out: out + ",\"infinite\":" + infinite + "}"
    innerCPP: "args._data = nullptr; args._size = 0;"
    out
)

# User-facing help
showCliHelp::{}: (
    print: "Commands:"
    print: "  put <key> <value> [ttl=SECONDS] [infinite=true|false]"
    print: "  get <key>"
    print: "  Text keys are hashed. Use hex:<node_id> or 0x<node_id> for an explicit NodeID."
    print: "  group.put <group> <key=value> [key=value ...] [ttl=SECONDS] [infinite=true|false]"
    print: "  group.get <group>"
    print: "  nearest <hex_target>"
    print: "  cli [host[:port]|url]"
    print: "  node.start [config]"
    print: "  node.stop"
    print: "  node.restart [config]"
    print: "  node.status"
    print: "  node.use"
    print: "  help"
    print: "  exit"
    print: "  quit"
)

showHelp::{String}: (
    program: Ri
    print: "Jada " + JADA_VERSION
    print: ""
    print: "Usage:"
    print: "  " + program
    print: "  " + program + " --cli [host:port]"
    print: "  " + program + " --config <path>"
    print: "  " + program + " --config <path> --cli [host:port]"
    print: "  " + program + " --daemon [--config <path>]"
    print: "  " + program + " -h"
    print: "  " + program + " --version"
    print: ""
    print: "Modes:"
    print: "  No node flags opens the interactive client only."
    print: "  --config or --daemon runs a node only."
    print: "  Combine --config or --daemon with --cli to run a node and client together."
    print: ""
    print: "Options:"
    print: "  --cli [target]    Open the CLI. The target may be a domain, URL, IPv4, or IPv6 address"
    print: "  --config <path>   Node configuration file"
    print: "  --daemon          Run node mode using config.json unless --config is supplied"
    print: "  -h, --help        Show this help"
    print: "  --version         Show the Jada version"
    print: ""
    print: "The CLI can manage an in-process node with node.start, node.stop, and related commands."
    print: "Post-quantum signature support remains experimental."
)

sendRequest::{target:String,payload:String}: (
    response: nativeExchange: Ri.target, DEFAULT_API_PORT, Ri.payload
    print: response
)

# Interactive Hachi client
runCli::{String}: (
    target: Ri
    target.len = 0 ? (
        target: DEFAULT_CLI_TARGET
    )|(
        pass
    )

    dog: 240.toascii + 159.toascii + 144.toascii + 182.toascii
    print: dog + " Jada " + JADA_VERSION
    print: "CLI target: " + target
    print: "Type 'help' for commands. Type 'exit' or 'quit' to leave."

    running: tru
    running @ (
        line: readLine: "jada> "
        line = EOF_MARKER ? (
            running: fls
        )|(
            args: tokenize: line
            args.len = 0 ? (
                pass
            )|(
                command: args.get: 0
                isExitCommand: command ? (
                    running: fls
                )|(
                command = "help" ? (
                    showCliHelp
                )|(
                command = "cli" ? (
                    args.len = 1 ? (
                        print: "CLI target: " + target
                    )|(
                        target: args.get: 1
                        print: "CLI target set to: " + target
                    )
                )|(
                command = "node.start" ? (
                    configPath: DEFAULT_CONFIG
                    args.len > 1 ? (
                        configPath: args.get: 1
                    )|(
                        pass
                    )
                    result: nativeStartLocalNode: configPath
                    print: result
                    localTarget: nativeLocalNodeTarget
                    localTarget.len > 0 ? (
                        target: localTarget
                        print: "CLI target set to managed local node: " + target
                    )|(
                        pass
                    )
                )|(
                command = "node.stop" ? (
                    result: nativeStopLocalNode
                    print: result
                )|(
                command = "node.restart" ? (
                    configPath: DEFAULT_CONFIG
                    args.len > 1 ? (
                        configPath: args.get: 1
                    )|(
                        pass
                    )
                    stopped: nativeStopLocalNode
                    print: stopped
                    started: nativeStartLocalNode: configPath
                    print: started
                    localTarget: nativeLocalNodeTarget
                    localTarget.len > 0 ? (
                        target: localTarget
                        print: "CLI target set to managed local node: " + target
                    )|(
                        pass
                    )
                )|(
                command = "node.status" ? (
                    print: nativeLocalNodeStatus
                )|(
                command = "node.use" ? (
                    localTarget: nativeLocalNodeTarget
                    localTarget.len > 0 ? (
                        target: localTarget
                        print: "CLI target set to managed local node: " + target
                    )|(
                        print: "Managed local node is not running."
                    )
                )|(
                command = "put" ? (
                    args.len < 3 ? (
                        print: "error: put requires <key> <value>"
                    )|(
                        payload: putPayload: args
                        sendRequest: target, payload
                    )
                )|(
                command = "get" ? (
                    args.len < 2 ? (
                        print: "error: get requires <key>"
                    )|(
                        payload: getPayload: args.get: 1
                        sendRequest: target, payload
                    )
                )|(
                command = "group.put" ? (
                    args.len < 3 ? (
                        print: "error: group.put requires <group> and at least one key=value item"
                    )|(
                        payload: groupPutPayload: args
                        sendRequest: target, payload
                    )
                )|(
                command = "group.get" ? (
                    args.len < 2 ? (
                        print: "error: group.get requires <group>"
                    )|(
                        payload: groupGetPayload: args.get: 1
                        sendRequest: target, payload
                    )
                )|(
                command = "nearest" ? (
                    args.len < 2 ? (
                        print: "error: nearest requires <hex_target>"
                    )|(
                        payload: nearestPayload: args.get: 1
                        sendRequest: target, payload
                    )
                )|(
                    print: "error: unknown command '" + command + "'"
                    print: "type 'help' for available commands"
                )))))))))))))
            )
        )
    )
)

# Process entry point
mainArgs: argv
programName: "jada"
nodeMode: fls
cliRequested: fls
nodeConfigPath: DEFAULT_CONFIG
cliTarget: ""
parseOk: tru

mainIndex: 0 | mainIndex < mainArgs.len | mainIndex: mainIndex + 1 @ (
    currentArg: mainArgs.get: mainIndex
    currentArg = "--config" ? (
        mainIndex + 1 < mainArgs.len ? (
            nodeConfigPath: mainArgs.get: mainIndex + 1
            nodeMode: tru
            mainIndex: mainIndex + 1
        )|(
            print: "error: --config requires a path"
            parseOk: fls
        )
    )|(
    currentArg = "--daemon" ? (
        nodeMode: tru
    )|(
    currentArg = "--cli" ? (
        cliRequested: tru
        mainIndex + 1 < mainArgs.len ? (
            possibleTarget: mainArgs.get: mainIndex + 1
            startsWith: possibleTarget, "-" ? (
                pass
            )|(
                cliTarget: possibleTarget
                mainIndex: mainIndex + 1
            )
        )|(
            pass
        )
    )|(
    isHelpOption: currentArg ? (
        showHelp: programName
        exitWith: 0
    )|(
    currentArg = "--version" ? (
        print: JADA_VERSION
        exitWith: 0
    )|(
        print: "error: unknown option " + currentArg
        parseOk: fls
    )))))
)

parseOk ? (
    nodeMode ? (
        cliRequested ? (
            started: nativeStartLocalNode: nodeConfigPath
            print: started
            cliTarget.len = 0 ? (
                cliTarget: nativeLocalNodeTarget
            )|(
                pass
            )
            runCli: cliTarget
            stopped: nativeStopLocalNode
            print: stopped
        )|(
            nodeStatus: nativeRunNode: nodeConfigPath
            exitWith: nodeStatus
        )
    )|(
        runCli: cliTarget
    )
)|(
    showHelp: programName
    exitWith: 1
)
